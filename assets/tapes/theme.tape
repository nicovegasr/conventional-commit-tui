# Shared look for every README tape: the palette of docs/ux-mockups.html.
Set Shell "bash"
Set FontFamily "Menlo"
Set FontSize 15
Set LineHeight 1.25
Set Padding 24
Set WindowBar Colorful
Set Theme { "name": "nib", "background": "#0d1117", "foreground": "#c9d1d9", "cursor": "#3fb950", "selection": "#1f6feb55", "black": "#484f58", "red": "#f85149", "green": "#3fb950", "yellow": "#d29922", "blue": "#58a6ff", "magenta": "#bc8cff", "cyan": "#39c5cf", "white": "#c9d1d9", "brightBlack": "#6e7781", "brightRed": "#ff7b72", "brightGreen": "#56d364", "brightYellow": "#e3b341", "brightBlue": "#79c0ff", "brightMagenta": "#d2a8ff", "brightCyan": "#56d4dd", "brightWhite": "#f0f6fc" }
